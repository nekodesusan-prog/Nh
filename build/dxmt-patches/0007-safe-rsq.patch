 extern "C" bool madeira_precise_math();   /* MADEIRA: nt/air_builder.cpp */
+static bool
+madeira_safe_rsq() {
+  static int mode = -1;
+  if (mode < 0) {
+    const char *e = getenv("DXMT_SAFE_RSQ");
+    mode = (e && e[0] == '1') ? 1 : 0;
+    if (mode)
+      fprintf(stderr, "[airconv] DXMT_SAFE_RSQ: rsq(x) = rsq(max(x, 1e-24))\n");
+  }
+  return mode != 0;
+}
 
 namespace dxmt::dxbc {
 
@@ -986,6 +997,13 @@ Converter::operator()(const InstFloatUnaryOp &unary) {
     Value = ir.CreateFDiv(llvm::ConstantFP::get(Value->getType(), 1.0), Value);
     break;
   case FloatUnaryOp::Rsq:
+    /* MADEIRA: DXMT_SAFE_RSQ=1 takes rsq of max(x, 1e-24): rsq(0) is a large finite
+     * number instead of +Inf, and a negative or NaN input no longer gives NaN, so a
+     * normalize() of a zero-length vector is 0 rather than NaN. KINGDOM HEARTS III's
+     * character base-pass shaders normalize a tangent frame that comes out zero on
+     * some pixels; the NaN normals turned into tiled blocks around characters. */
+    if (madeira_safe_rsq())
+      Value = air.CreateFPBinOp(AIRBuilder::fmax, Value, llvm::ConstantFP::get(Value->getType(), 1e-24), false);
     Value = air.CreateFPUnOp(AIRBuilder::rsqrt, Value);
     break;
   case FloatUnaryOp::Sqrt:
