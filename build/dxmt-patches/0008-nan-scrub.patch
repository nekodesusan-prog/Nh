+/* MADEIRA: DXMT_NAN_SCRUB=id[,id...] (ids as DXMT_NAN_TAG's [nan-tag] lines print
+ * them, or "all") cleans every float result those shaders store: NaN -> 0 and
+ * +/-Inf -> +/-1e30. A NaN then never spreads through the rest of the shader;
+ * the one term it hit is 0 instead of the whole output. KINGDOM HEARTS III's
+ * character base-pass shaders (8b5ea11b, 420f99cd) make NaN somewhere in their
+ * lighting; downstream it became white bloom discs or dark tiles. */
+extern thread_local uint32_t madeira_tag_shader;
+llvm::Value *
+Converter::MadeiraScrub(llvm::Value *Value) {
+  static int mode = -1;   /* 0 off, 1 listed shaders, 2 all */
+  static std::string list;
+  if (mode < 0) {
+    const char *e = getenv("DXMT_NAN_SCRUB");
+    list = e ? e : "";
+    mode = list.empty() ? 0 : (list == "all" ? 2 : 1);
+    if (mode)
+      fprintf(stderr, "[airconv] DXMT_NAN_SCRUB=%s: NaN -> 0, Inf -> +/-1e30 after every float result\n", list.c_str());
+  }
+  if (!mode || !Value || !Value->getType()->isFPOrFPVectorTy())
+    return Value;
+  if (mode == 1) {
+    char idhex[16];
+    snprintf(idhex, sizeof idhex, "%08x", madeira_tag_shader);
+    if (list.find(idhex) == std::string::npos)
+      return Value;
+  }
+  llvm::IRBuilder<>::FastMathFlagGuard guard(ir);
+  ir.setFastMathFlags(llvm::FastMathFlags());
+  auto *Ty = Value->getType();
+  auto *Zero = llvm::ConstantFP::get(Ty, 0.0);
+  auto *PInf = llvm::ConstantFP::getInfinity(Ty, false);
+  auto *NInf = llvm::ConstantFP::getInfinity(Ty, true);
+  auto *PBig = llvm::ConstantFP::get(Ty, 1e30);
+  auto *NBig = llvm::ConstantFP::get(Ty, -1e30);
+  Value = ir.CreateSelect(ir.CreateFCmpUNO(Value, Value), Zero, Value);
+  Value = ir.CreateSelect(ir.CreateFCmpOEQ(Value, PInf), PBig, Value);
+  Value = ir.CreateSelect(ir.CreateFCmpOEQ(Value, NInf), NBig, Value);
+  return Value;
+}
