 #include "air_builder.hpp"
 #include "llvm/ADT/SmallVector.h"
 #include "llvm/IR/DerivedTypes.h"
@@ -8,6 +10,24 @@
 #include "llvm/Support/raw_ostream.h"
 #include <format>
 
+/* MADEIRA: DXMT_PRECISE_MATH=1 uses Metal's precise math functions (air.rsqrt,
+ * air.log2, air.pow, ...) instead of the fast ones, and no fast-math flags.
+ * The fast variants leave edge cases undefined (log2(0), pow(0, y), rsqrt(0)),
+ * where D3D11 gives -inf/0/inf; a NaN from one of them reached KINGDOM HEARTS
+ * III's post-processing (white bloom discs, then dark blocks around characters).
+ * Opt-in; dxmt_shader_cache.cpp keeps a separate cache file for it. */
+extern "C" bool
+madeira_precise_math() {
+  static int mode = -1;
+  if (mode < 0) {
+    const char *e = getenv("DXMT_PRECISE_MATH");
+    mode = (e && e[0] == '1') ? 1 : 0;
+    if (mode)
+      fprintf(stderr, "[airconv] DXMT_PRECISE_MATH: precise math functions, no fast-math flags\n");
+  }
+  return mode != 0;
+}
+
