-                      env::getEnvVar("DXMT_NAN_TAG").empty() ? "" : "_nantag" + env::getEnvVar("DXMT_NAN_TAG"), ".db");
+                      env::getEnvVar("DXMT_NAN_TAG").empty() ? "" : "_nantag" + env::getEnvVar("DXMT_NAN_TAG"),
