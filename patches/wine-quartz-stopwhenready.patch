+
+/* Madeira: StopWhenReady stops the graph once it has paused -- unless the
+ * application changed the state itself in the meantime.  An AI6WIN visual
+ * novel calls StopWhenReady (to cue its movie) and then Run before the first
+ * picture arrives; the deferred Stop used to fire after the Run and stop the
+ * movie the game had just started, and the game then waited forever for it
+ * (a black screen, or the last picture held). */
 static void CALLBACK wait_pause_cb(TP_CALLBACK_INSTANCE *instance, void *context)
 {
-    IMediaControl *control = context;
+    struct stop_when_ready *ctx = context;
+    IMediaControl *control = ctx->control;
+    struct filter_graph *graph = impl_from_IMediaControl(control);
     OAFilterState state;
     HRESULT hr;
 
     if ((hr = IMediaControl_GetState(control, INFINITE, &state)) != S_OK)
         ERR("Failed to get paused state, hr %#lx.\n", hr);
 
-    if (FAILED(hr = IMediaControl_Stop(control)))
-        ERR("Failed to stop, hr %#lx.\n", hr);
+    if (ReadNoFence(&graph->state_change_seq) != ctx->seq)
+    {
+        TRACE("graph %p: the state changed after StopWhenReady; not stopping.\n", graph);
+    }
+    else
+    {
+        if (FAILED(hr = IMediaControl_Stop(control)))
+            ERR("Failed to stop, hr %#lx.\n", hr);
 
-    if ((hr = IMediaControl_GetState(control, INFINITE, &state)) != S_OK)
-        ERR("Failed to get paused state, hr %#lx.\n", hr);
+        if ((hr = IMediaControl_GetState(control, INFINITE, &state)) != S_OK)
+            ERR("Failed to get paused state, hr %#lx.\n", hr);
+    }
 
     IMediaControl_Release(control);
+    free(ctx);
 }
 
 static void CALLBACK wait_stop_cb(TP_CALLBACK_INSTANCE *instance, void *context)
