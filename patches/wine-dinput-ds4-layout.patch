+/* DS4: a trigger is its own axis, 0..255, resting at the minimum as on the
+ * real pad; L2/R2 are also buttons 6/7, pressed past a small threshold. */
+static void ios_logical_state_ds4( const XINPUT_GAMEPAD *pad, LONG values[IOS_MAX_VALUES], BYTE buttons[IOS_MAX_BUTTONS] )
+{
+    static const WORD mask[IOS_MAX_BUTTONS] =
+    {
+        XINPUT_GAMEPAD_X,               /* 0 Square   */
+        XINPUT_GAMEPAD_A,               /* 1 Cross    */
+        XINPUT_GAMEPAD_B,               /* 2 Circle   */
+        XINPUT_GAMEPAD_Y,               /* 3 Triangle */
+        XINPUT_GAMEPAD_LEFT_SHOULDER,   /* 4 L1       */
+        XINPUT_GAMEPAD_RIGHT_SHOULDER,  /* 5 R1       */
+        0,                              /* 6 L2: from the trigger */
+        0,                              /* 7 R2: from the trigger */
+        XINPUT_GAMEPAD_BACK,            /* 8 Share    */
+        XINPUT_GAMEPAD_START,           /* 9 Options  */
+        XINPUT_GAMEPAD_LEFT_THUMB,      /* 10 L3      */
+        XINPUT_GAMEPAD_RIGHT_THUMB,     /* 11 R3      */
+        0x0400,                         /* 12 PS: the guide bit, when the host reports it */
+        0,                              /* 13 Touchpad: not reported */
+    };
+    UINT i;
+
+    values[IOS_DS4_X]   = ios_logical_stick( pad->sThumbLX );
+    values[IOS_DS4_Y]   = ios_logical_stick_inverted( pad->sThumbLY );
+    values[IOS_DS4_Z]   = ios_logical_stick( pad->sThumbRX );
+    values[IOS_DS4_RX]  = pad->bLeftTrigger;
+    values[IOS_DS4_RY]  = pad->bRightTrigger;
+    values[IOS_DS4_RZ]  = ios_logical_stick_inverted( pad->sThumbRY );
+    values[IOS_DS4_POV] = ios_logical_pov( pad->wButtons );
+
+    for (i = 0; i < IOS_MAX_BUTTONS; ++i)
+        buttons[i] = (mask[i] && (pad->wButtons & mask[i])) ? 0x80 : 0x00;
+    buttons[6] = pad->bLeftTrigger > 30 ? 0x80 : 0x00;
+    buttons[7] = pad->bRightTrigger > 30 ? 0x80 : 0x00;
+}
+
+static void ios_logical_state( const XINPUT_GAMEPAD *pad, LONG values[IOS_MAX_VALUES], BYTE buttons[IOS_MAX_BUTTONS] )
 {
     UINT i;
 
+    if (ios_layout_ds4())
+    {
+        ios_logical_state_ds4( pad, values, buttons );
+        return;
+    }
+
     values[IOS_OBJ_X]   = ios_logical_stick( pad->sThumbLX );
     values[IOS_OBJ_Y]   = ios_logical_stick_inverted( pad->sThumbLY );
     values[IOS_OBJ_Z]   = ios_logical_triggers( pad->bLeftTrigger, pad->bRightTrigger );
