+      DIDOI_ASPECTPOSITION, HID_USAGE_PAGE_GENERIC, usage, name }
+    IOS_AXIS( IOS_DS4_X,  0, &GUID_XAxis,  HID_USAGE_GENERIC_X,  L"X Axis" ),
+    IOS_AXIS( IOS_DS4_Y,  1, &GUID_YAxis,  HID_USAGE_GENERIC_Y,  L"Y Axis" ),
+    IOS_AXIS( IOS_DS4_Z,  2, &GUID_ZAxis,  HID_USAGE_GENERIC_Z,  L"Z Axis" ),
+    IOS_AXIS( IOS_DS4_RX, 3, &GUID_RxAxis, HID_USAGE_GENERIC_RX, L"X Rotation" ),
+    IOS_AXIS( IOS_DS4_RY, 4, &GUID_RyAxis, HID_USAGE_GENERIC_RY, L"Y Rotation" ),
+    IOS_AXIS( IOS_DS4_RZ, 5, &GUID_RzAxis, HID_USAGE_GENERIC_RZ, L"Z Rotation" ),
+#undef IOS_AXIS
+    { &GUID_POV, IOS_VALUE_OFS( IOS_DS4_POV ), DIDFT_POV | DIDFT_MAKEINSTANCE( 0 ),
+      0, HID_USAGE_PAGE_GENERIC, HID_USAGE_GENERIC_HATSWITCH, L"Hat Switch" },
+#define IOS_BUTTON( n, name )                                                                 \
+    { &GUID_Button, IOS_DS4_BUTTON_OFS( n ), DIDFT_PSHBUTTON | DIDFT_MAKEINSTANCE( n ),       \
+      0, HID_USAGE_PAGE_BUTTON, (n) + 1, name }
+    IOS_BUTTON( 0, L"Button 0" ), IOS_BUTTON( 1, L"Button 1" ), IOS_BUTTON( 2, L"Button 2" ),
+    IOS_BUTTON( 3, L"Button 3" ), IOS_BUTTON( 4, L"Button 4" ), IOS_BUTTON( 5, L"Button 5" ),
+    IOS_BUTTON( 6, L"Button 6" ), IOS_BUTTON( 7, L"Button 7" ), IOS_BUTTON( 8, L"Button 8" ),
+    IOS_BUTTON( 9, L"Button 9" ), IOS_BUTTON( 10, L"Button 10" ), IOS_BUTTON( 11, L"Button 11" ),
+    IOS_BUTTON( 12, L"Button 12" ), IOS_BUTTON( 13, L"Button 13" ),
+#undef IOS_BUTTON
+};
+
+/* The table in use, and its value / button counts. */
+static const struct ios_object *ios_table( UINT *count, UINT *values, UINT *buttons )
+{
+    if (ios_layout_ds4())
+    {
+        if (count) *count = IOS_DS4_COUNT;
+        if (values) *values = IOS_DS4_VALUE_COUNT;
+        if (buttons) *buttons = 14;
+        return ios_objects_ds4;
+    }
+    if (count) *count = IOS_OBJ_COUNT;
+    if (values) *values = IOS_VALUE_COUNT;
+    if (buttons) *buttons = 10;
+    return ios_objects;
+}
