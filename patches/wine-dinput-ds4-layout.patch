+/* MADEIRA: the DualShock 4 layout (MADEIRA_DINPUT_LAYOUT=ds4).
+ *
+ * What Windows' HID class driver reports for a DualShock 4 (054C:09CC) with
+ * no Steam Input in between: X/Y the left stick, Z/Rz the right stick, Rx/Ry
+ * the L2/R2 triggers resting at their minimum, a hat, and 14 buttons in the
+ * order Square Cross Circle Triangle L1 R1 L2 R2 Share Options L3 R3 PS
+ * Touchpad. A DirectInput game with its own map for a PlayStation pad (KINGDOM
+ * HEARTS HD 2.8 reads its pad only through DirectInput, and with the XUSB
+ * layout above every face button landed on the wrong action) finds the buttons
+ * where that map expects them. The XUSB layout stays the default. */
+enum ios_ds4_index
+{
+    IOS_DS4_X = 0,
+    IOS_DS4_Y,
+    IOS_DS4_Z,
+    IOS_DS4_RX,
+    IOS_DS4_RY,
+    IOS_DS4_RZ,
+    IOS_DS4_POV,
+    IOS_DS4_BUTTON_0,
+    IOS_DS4_COUNT = IOS_DS4_BUTTON_0 + 14,
+};
+#define IOS_DS4_VALUE_COUNT  (IOS_DS4_POV + 1)
+#define IOS_DS4_BUTTON_OFS(i) (IOS_DS4_VALUE_COUNT * sizeof(LONG) + (i))
+#define IOS_MAX_VALUES  IOS_DS4_VALUE_COUNT
+#define IOS_MAX_BUTTONS 14
+#define IOS_DS4_VID 0x054c
+#define IOS_DS4_PID 0x09cc
+
+static int ios_dinput_layout = -1;   /* 0 XUSB (default), 1 DualShock 4 */
+
+static BOOL ios_layout_ds4( void )
+{
+    int v = __atomic_load_n( &ios_dinput_layout, __ATOMIC_RELAXED );
+
+    if (v < 0)
+    {
+        const char *e = getenv( "MADEIRA_DINPUT_LAYOUT" );
+        v = (e && !strcasecmp( e, "ds4" )) ? 1 : 0;
+        __atomic_store_n( &ios_dinput_layout, v, __ATOMIC_RELAXED );
+        if (v) ERR( "[dinput] iOS joystick presented as a DualShock 4 (MADEIRA_DINPUT_LAYOUT=ds4)\n" );
+    }
+    return v;
+}
+
