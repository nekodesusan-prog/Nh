+          * launcher crashed there. As on Windows, the chain ends with a zero. */
+         "str xzr, [sp]\n\t"
+         "mov x29, xzr\n\t"
          "adrp x11, pBaseThreadInitThunk\n\t"
          "ldr x11, [x11, #:lo12:pBaseThreadInitThunk]\n\t"
          "adr x10, $iexit_thunk$cdecl$v$i8i8i8\n\t"
