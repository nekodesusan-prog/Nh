@@ -5077,6 +5077,13 @@ void __attribute__((naked)) RtlUserThreadStart( PRTL_THREAD_START_ROUTINE entry,
          "stp x29, x30, [sp, #-16]!\n\t"
          ".seh_save_fplr_x 16\n\t"
          ".seh_endprologue\n\t"
+         /* Madeira: x29 arrives holding a leftover kernel-stack address just above
