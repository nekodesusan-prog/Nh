 /* Perform the paused -> running transition. The caller must hold graph->cs. */
+static LONGLONG graph_start_delay(void)
+{
+    static LONG delay = -1;
+    LONG value = ReadNoFence(&delay);
+
+    if (value < 0)
+    {
+        char buffer[16];
+        DWORD len = GetEnvironmentVariableA("MADEIRA_DSHOW_START_DELAY_MS", buffer, sizeof(buffer));
+
+        value = 30;
+        if (len && len < sizeof(buffer))
+        {
+            value = atoi(buffer);
+            if (value < 0) value = 0;
+            if (value > 1000) value = 1000;
+        }
+        InterlockedExchange(&delay, value);
+    }
+    return value;
+}
